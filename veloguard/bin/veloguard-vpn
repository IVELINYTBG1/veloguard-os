#!/usr/bin/env bash
#
# veloguard-vpn — set up the VPN exit (WireGuard profiles + Tor fallback).
#
# Replaces the dangerous peer-relay idea with a real endpoint you control or
# trust: ProtonVPN (free tier), your own server, or Mullvad/Surfshark. The
# default profile is named "veloguard" so the guard's `vpn_up` just works.
#
#   veloguard-vpn import ~/proton.conf      # install as the default profile
#   veloguard-vpn import ~/work.conf work   # extra named profile
#   veloguard-vpn tor                       # install + enable the Tor fallback
#   veloguard-vpn proton|mullvad|surfshark  # where to get a config
#   veloguard-vpn status
#
set -euo pipefail
WG=/etc/wireguard
say()  { printf '\033[1;36m[veloguard-vpn]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[veloguard-vpn]\033[0m %s\n' "$*" >&2; }
priv() { if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi; }

cmd="${1:-help}"; shift || true
case "$cmd" in
  import)
    src="${1:?usage: veloguard-vpn import <wg.conf> [name]}"; name="${2:-veloguard}"
    [ -f "$src" ] || { warn "no such file: $src"; exit 1; }
    priv install -m600 -D "$src" "$WG/$name.conf"
    say "installed $WG/$name.conf (chmod 600)"
    say "bring it up:  guardd --apply --yes \"turn on vpn\"   (profile: $name)"
    [ "$name" = veloguard ] || say "non-default name — set pref: guardd uses 'veloguard' unless vpn_profile is changed"
    ;;
  tor)
    if   command -v pacman  >/dev/null; then priv pacman -S --noconfirm --needed tor
    elif command -v dnf     >/dev/null; then priv dnf install -y tor
    elif command -v apt-get >/dev/null; then priv apt-get update && priv apt-get install -y tor
    else warn "install 'tor' manually"; exit 1; fi
    priv systemctl enable --now tor && say "Tor fallback ready (use profile 'tor')"
    ;;
  proton)    say "Proton: account.proton.me → Downloads → WireGuard → create a (free) config → veloguard-vpn import <file>";;
  mullvad)   say "Mullvad: mullvad.net/account → WireGuard config → veloguard-vpn import <file>";;
  surfshark) say "Surfshark: my.surfshark.com → Manual setup → WireGuard → veloguard-vpn import <file>";;
  status)
    command -v wg >/dev/null && priv wg show 2>/dev/null || say "no WireGuard tunnel up"
    systemctl is-active tor >/dev/null 2>&1 && say "tor: active" || true
    ;;
  *) echo "usage: veloguard-vpn import <wg.conf> [name] | tor | proton | mullvad | surfshark | status";;
esac
