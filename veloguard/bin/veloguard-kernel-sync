#!/usr/bin/env bash
#
# veloguard-kernel-sync — bring our kernel tree up to Linus's latest STABLE
# release tag, re-apply the VeloGuardOS config fragments, and full-build it
# out-of-tree. Built to be driven by an agent: deterministic, idempotent, and
# it ends with a machine-readable  VGKSYNC_JSON: {…}  line.
#
# `origin` is Linus's tree (github.com/torvalds/linux). Our overlay (veloguard/)
# is UNTRACKED in this kernel repo, so checking out a tag never touches it — the
# kernel files move, our code rides along. We build with O=<dir> so the source
# tree stays pristine for the next checkout.
#
# Modes:
#   veloguard-kernel-sync                # fetch → latest stable tag → full build
#   veloguard-kernel-sync --check-only   # no fetch/checkout/build: just validate
#                                        #   fragments against the CURRENT tree
#   veloguard-kernel-sync --no-build     # fetch + checkout + config, skip compile
#   veloguard-kernel-sync --dry-run      # print the plan, change nothing
#   veloguard-kernel-sync --tag v7.1     # pin a tag instead of latest-stable
#   veloguard-kernel-sync --arch arm64   # target arm64 (default: x86_64)
#   veloguard-kernel-sync --jobs N       # parallelism (default: nproc)
#   veloguard-kernel-sync --skip-if-current   # no-op when already on the tag
#
set -uo pipefail

# ---- locate the kernel tree + our fragments -------------------------------
SELF="$(cd "$(dirname "$0")" && pwd)"
TREE="$(cd "$SELF/../.." && pwd)"          # veloguard/bin/../.. = kernel root
FRAG_DIR="$TREE/veloguard/kernel"

ARCH=x86_64; JOBS="$(nproc)"; DO_FETCH=1; DO_BUILD=1; DO_CHECKOUT=1
DRY=0; CHECK_ONLY=0; PIN_TAG=""; SKIP_IF_CURRENT=0

say()  { printf '\033[1;36m[kernel-sync]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[kernel-sync]\033[0m %s\n' "$*" >&2; }
json_str() { printf '"%s"' "$(printf '%s' "${1:-}" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }
die()  { printf '\033[1;31m[kernel-sync]\033[0m %s\n' "$*" >&2
         printf 'VGKSYNC_JSON: {"ok":false,"error":%s}\n' "$(json_str "$*")"; exit 1; }

while [ $# -gt 0 ]; do
  case "$1" in
    --no-fetch)        DO_FETCH=0 ;;
    --no-build)        DO_BUILD=0 ;;
    --dry-run)         DRY=1 ;;
    --check-only)      CHECK_ONLY=1; DO_FETCH=0; DO_CHECKOUT=0; DO_BUILD=0 ;;
    --skip-if-current) SKIP_IF_CURRENT=1 ;;
    --tag)  PIN_TAG="${2:?--tag needs a value}";  shift ;;
    --arch) ARCH="${2:?--arch needs a value}";    shift ;;
    --jobs) JOBS="${2:?--jobs needs a value}";     shift ;;
    -h|--help) grep '^#' "$0" | sed 's/^#\{1,\} \{0,1\}//'; exit 0 ;;
    *) die "unknown arg: $1" ;;
  esac
  shift
done

# ---- arch-specific defconfig + fragments + image path ---------------------
case "$ARCH" in
  x86_64) DEFCONFIG="arch/x86/configs/x86_64_defconfig"
          FRAGS=("$FRAG_DIR/veloguardos-base.config"
                 "$FRAG_DIR/veloguardos-desktop.config"
                 "$FRAG_DIR/veloguardos-hardware.config")
          IMAGE_REL="arch/x86/boot/bzImage"; MAKEARCH=() ;;
  arm64)  DEFCONFIG="arch/arm64/configs/defconfig"
          FRAGS=("$FRAG_DIR/veloguardos-arm64.config")
          IMAGE_REL="arch/arm64/boot/Image"; MAKEARCH=(ARCH=arm64) ;;
  *) die "unsupported --arch '$ARCH' (use x86_64 or arm64)" ;;
esac
BUILD="${VGK_BUILD:-/tmp/veloguard-kbuild/$ARCH}"

# ---- sanity ---------------------------------------------------------------
[ -f "$TREE/Makefile" ] && [ -d "$TREE/arch" ] || die "not a kernel tree: $TREE"
for f in "${FRAGS[@]}"; do [ -f "$f" ] || die "missing config fragment: $f"; done

miss=""
for t in gcc make ld bison flex bc; do command -v "$t" >/dev/null || miss="$miss $t"; done
if [ "$DO_BUILD" = 1 ] && [ "$DRY" = 0 ]; then
  [ -e /usr/include/libelf.h ] || [ -e /usr/include/elfutils/libelf.h ] || miss="$miss libelf-headers"
fi
[ -z "$miss" ] || die "missing build deps:$miss  (Fedora: sudo dnf install gcc make binutils bison flex bc elfutils-libelf-devel openssl-devel; Arch: sudo pacman -S --needed base-devel bc)"

cd "$TREE" || die "cannot cd $TREE"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$TREE is not a git repo"
# Refuse to run over local kernel edits; our untracked overlay is fine.
[ -z "$(git status --porcelain --untracked-files=no)" ] || \
  die "tracked kernel files are modified — commit or stash before sync (won't clobber your edits)"

START=$(date +%s)
FROM_DESC="$(git describe --tags --always 2>/dev/null || echo unknown)"

# ---- fetch + pick the target tag ------------------------------------------
if [ "$DO_FETCH" = 1 ]; then
  say "fetching from origin ($(git config --get remote.origin.url))…"
  if [ "$DRY" = 1 ]; then say "DRY: git fetch --tags --prune origin"
  else git fetch --tags --prune origin || die "git fetch failed"; fi
fi

if [ "$CHECK_ONLY" = 1 ]; then
  TARGET="$FROM_DESC"
elif [ -n "$PIN_TAG" ]; then
  TARGET="$PIN_TAG"
else
  # Linus's tree carries vX.Y (mainline releases) + vX.Y-rcN. "Latest stable"
  # = highest vX.Y with no -rc suffix.
  TARGET="$(git tag --list 'v*' --sort=-v:refname | grep -vE '\-rc' | head -1)"
fi
[ -n "$TARGET" ] || die "could not determine a target tag"
say "current: $FROM_DESC    target: $TARGET    arch: $ARCH    jobs: $JOBS    build-dir: $BUILD"

# ---- checkout the tag (detached; overlay untouched) -----------------------
if [ "$DO_CHECKOUT" = 1 ]; then
  git rev-parse -q --verify "refs/tags/$TARGET" >/dev/null 2>&1 || die "tag '$TARGET' not found locally (run without --no-fetch?)"
  CUR_EXACT="$(git describe --tags --exact-match 2>/dev/null || true)"
  if [ "$CUR_EXACT" = "$TARGET" ] && [ "$SKIP_IF_CURRENT" = 1 ]; then
    say "already on $TARGET and --skip-if-current set → nothing to do"
    printf 'VGKSYNC_JSON: {"ok":true,"from":%s,"to":%s,"build":"skipped","reason":"already-current"}\n' \
      "$(json_str "$FROM_DESC")" "$(json_str "$TARGET")"
    exit 0
  fi
  if [ "$DRY" = 1 ]; then say "DRY: git checkout --detach $TARGET"
  else say "checking out $TARGET…"; git checkout --quiet --detach "$TARGET" || die "checkout $TARGET failed"; fi
fi

# ---- config: merge fragments + olddefconfig + dropped-symbol audit --------
DROPPED=""
if [ "$DRY" = 1 ]; then
  say "DRY: merge_config.sh -m -O $BUILD $DEFCONFIG ${FRAGS[*]}"
  say "DRY: make O=$BUILD ${MAKEARCH[*]} olddefconfig"
else
  say "merging fragments → $BUILD/.config …"
  mkdir -p "$BUILD"
  scripts/kconfig/merge_config.sh -m -O "$BUILD" "$DEFCONFIG" "${FRAGS[@]}" >/dev/null 2>&1 \
    || die "merge_config failed"
  make O="$BUILD" "${MAKEARCH[@]}" olddefconfig >/dev/null 2>&1 || die "olddefconfig failed"
  # Every requested CONFIG_ symbol must survive olddefconfig; unmet depends/select
  # silently drop them, so diff requested-vs-resolved (per CLAUDE.md).
  for f in "${FRAGS[@]}"; do
    while IFS= read -r line; do
      grep -qxF "$line" "$BUILD/.config" || DROPPED="$DROPPED ${line%%=*}"
    done < <(grep -E '^CONFIG_[A-Za-z0-9_]+=' "$f")
  done
  if [ -n "$DROPPED" ]; then warn "DROPPED/changed symbols:$DROPPED"
  else say "config OK — all requested symbols survived olddefconfig"; fi
fi

# ---- full build (out-of-tree) ---------------------------------------------
BUILD_STATUS="skipped"; IMAGE=""
if [ "$DRY" = 1 ] && [ "$DO_BUILD" = 1 ]; then
  say "DRY: make O=$BUILD ${MAKEARCH[*]} -j$JOBS"; BUILD_STATUS="dry"
elif [ "$DO_BUILD" = 1 ]; then
  say "building kernel ($ARCH, -j$JOBS) — this takes a while…"
  if make O="$BUILD" "${MAKEARCH[@]}" -j"$JOBS"; then
    BUILD_STATUS="ok"; IMAGE="$BUILD/$IMAGE_REL"; say "build OK → $IMAGE"
  else
    BUILD_STATUS="failed"; warn "build FAILED (see make output above)"
  fi
fi

# ---- machine-readable summary for the agent -------------------------------
SECS=$(( $(date +%s) - START ))
CFG_STATUS="ok"; [ -n "$DROPPED" ] && CFG_STATUS="dropped"
say "done in ${SECS}s — tag:$TARGET config:$CFG_STATUS build:$BUILD_STATUS"
printf 'VGKSYNC_JSON: {"ok":%s,"from":%s,"to":%s,"arch":%s,"config":%s,"dropped":%s,"build":%s,"image":%s,"seconds":%d}\n' \
  "$([ "$BUILD_STATUS" = failed ] && echo false || echo true)" \
  "$(json_str "$FROM_DESC")" "$(json_str "$TARGET")" "$(json_str "$ARCH")" \
  "$(json_str "$CFG_STATUS")" "$(json_str "${DROPPED# }")" \
  "$(json_str "$BUILD_STATUS")" "$(json_str "$IMAGE")" "$SECS"
[ "$BUILD_STATUS" = failed ] && exit 1 || exit 0
