#!/usr/bin/env bash
#
# veloguard-install — one command for every kind of install file.
#
# Detects the type of a local file (or downloads a URL first) and installs it
# the right way: AppImage, Flatpak, Snap, .deb, .rpm, Arch pkg, or a generic
# tarball. Cross-distro: if a native package doesn't match the base distro it
# falls back to `alien` conversion where possible.
#
#   veloguard-install ./Foo.AppImage
#   veloguard-install ./app.flatpakref
#   veloguard-install ./tool_1.2_amd64.deb
#   veloguard-install https://example.com/thing.rpm
#
set -euo pipefail

say()  { printf '\033[1;36m[veloguard-install]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[veloguard-install]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[veloguard-install]\033[0m %s\n' "$*" >&2; exit 1; }

# Run a privileged command, using sudo only when we're not already root.
priv() { if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi; }

[ $# -eq 1 ] || die "usage: veloguard-install <file-or-URL>"
TARGET="$1"

# If it's a URL, fetch it to a temp file first.
CLEANUP=""
if [[ "$TARGET" =~ ^https?:// ]]; then
  tmp="$(mktemp -d)"; CLEANUP="$tmp"
  fname="${TARGET##*/}"; [ -n "$fname" ] || fname="download"
  say "downloading $fname …"
  curl -fL --progress-bar -o "$tmp/$fname" "$TARGET" || die "download failed"
  TARGET="$tmp/$fname"
fi
trap '[ -n "$CLEANUP" ] && rm -rf "$CLEANUP"' EXIT

[ -f "$TARGET" ] || die "no such file: $TARGET"
lower="$(printf '%s' "$TARGET" | tr '[:upper:]' '[:lower:]')"

have() { command -v "$1" >/dev/null 2>&1; }

install_deb() {
  if   have apt-get; then priv apt-get install -y "./$1" 2>/dev/null || priv dpkg -i "$1" || die "dpkg failed"
  elif have alien && have rpm; then
    say ".deb on a non-Debian system → converting with alien"
    priv alien --to-rpm --install "$1" || die "alien conversion failed"
  else die ".deb needs a Debian base, or 'alien'+rpm to convert"; fi
}

install_rpm() {
  if   have dnf; then priv dnf install -y "$1"
  elif have rpm && ! have alien; then priv rpm -i "$1"
  elif have alien && have dpkg; then
    say ".rpm on a non-RPM system → converting with alien"
    priv alien --to-deb --install "$1" || die "alien conversion failed"
  else die ".rpm needs an RPM base, or 'alien'+dpkg to convert"; fi
}

case "$lower" in
  *.appimage)
    dest="$HOME/Applications"; mkdir -p "$dest"
    cp "$TARGET" "$dest/"; chmod +x "$dest/$(basename "$TARGET")"
    say "installed to $dest/$(basename "$TARGET") — run it directly (FUSE-mounted)."
    ;;
  *.flatpakref)
    have flatpak || die "flatpak not installed (run install-app-formats.sh)"
    flatpak install --user -y --from "$TARGET" ;;
  *.flatpak)
    have flatpak || die "flatpak not installed (run install-app-formats.sh)"
    flatpak install --user -y "$TARGET" ;;
  *.snap)
    have snap || die "snapd not installed (run install-app-formats.sh)"
    priv snap install --dangerous "$TARGET" ;;
  *.deb)             install_deb "$TARGET" ;;
  *.rpm)             install_rpm "$TARGET" ;;
  *.pkg.tar.zst|*.pkg.tar.xz)
    have pacman || die "Arch packages need pacman"
    priv pacman -U --noconfirm "$TARGET" ;;
  *.tar.gz|*.tgz|*.tar.xz|*.tar.bz2|*.tar.zst)
    dest="/opt/$(basename "${TARGET%.tar.*}")"
    say "generic tarball → extracting to $dest (no auto-integration possible)"
    priv mkdir -p "$dest"; priv tar -xf "$TARGET" -C "$dest"
    say "extracted. Look inside $dest for a binary or install script." ;;
  *)
    die "unknown install type: $TARGET
supported: .AppImage .flatpak .flatpakref .snap .deb .rpm .pkg.tar.* tarballs" ;;
esac
say "done."
