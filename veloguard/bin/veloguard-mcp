#!/usr/bin/env bash
#
# veloguard-mcp — the VeloGuard MCP server (stdio). Attach any MCP agent
# (Claude Code, Codex, custom) to the kernel tools, through the guard.
#
# Claude Code (.mcp.json):
#   {"mcpServers": {"veloguard": {"command": "veloguard-mcp",
#     "env": {"VELOGUARD_AGENT_AUTONOMY": "guarded"}}}}
#
# Autonomy: VELOGUARD_AGENT_AUTONOMY = read | guarded | full   (default guarded)
# Enforce : VELOGUARD_APPLY=1 to touch the kernel for real     (default dry-run)
#
HOME_DIR="${VELOGUARD_HOME:-$(cd "$(dirname "$0")/.." && pwd)}"
VENV="${VELOGUARD_VENV:-$HOME_DIR/.venv}"
PY="python3"; [ -x "$VENV/bin/python" ] && PY="$VENV/bin/python"
cd "$HOME_DIR"
exec "$PY" -m guardd.mcp_server "$@"
