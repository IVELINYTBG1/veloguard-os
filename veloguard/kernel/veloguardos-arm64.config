# VeloGuardOS — arm64 (AArch64) profile. So we don't exclude ARM users:
# Raspberry Pi, Apple Silicon (Asahi), Snapdragon laptops, Rockchip/Allwinner
# SBCs, and ARM servers (Ampere, Graviton).
#
# ARM is a SEPARATE architecture and a separate build. This fragment layers the
# VeloGuardOS essentials + ARM desktop GPUs on top of the kernel's already-broad
# arm64 defconfig. All userspace (guard daemon, setup wizard, provisioning,
# app-format tools) is arch-independent and works unchanged.
#
# Validate / build (config validation needs NO cross-compiler):
#   ./scripts/kconfig/merge_config.sh -m -O build-arm64 \
#       arch/arm64/configs/defconfig veloguard/kernel/veloguardos-arm64.config
#   make ARCH=arm64 O=build-arm64 olddefconfig
#   # full build also needs: make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu-

# --- Boot / initramfs / foreign binaries ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_MISC=m

# --- systemd + namespaces + cgroup-BPF (assert; sandbox & guard depend on it) ---
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_SECCOMP=y
CONFIG_SECURITY_LANDLOCK=y

# --- App-sandbox filesystems (Flatpak/AppImage/Snap) ---
CONFIG_FUSE_FS=y
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_OVERLAY_FS=m

# --- Netfilter / nftables (VeloGuard's guard) + WireGuard VPN ---
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_LOG=m
CONFIG_WIREGUARD=m
CONFIG_TUN=m
CONFIG_VETH=m

# --- Crypto accel + disk encryption (ARM CE instructions) ---
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_XTS=y
CONFIG_DM_CRYPT=m

# --- DRM core + generic display. Apple Silicon (Asahi) drives the display via
#     SIMPLEDRM today; the dedicated Apple GPU driver isn't upstream yet. ---
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_SYNC_FILE=y
CONFIG_DMABUF_HEAPS=y
CONFIG_UDMABUF=y

# --- ARM GPUs (modules; the matching one loads) ---
CONFIG_DRM_PANFROST=m
CONFIG_DRM_PANTHOR=m
CONFIG_DRM_LIMA=m
CONFIG_DRM_MSM=m
CONFIG_DRM_VC4=m
CONFIG_DRM_V3D=m
CONFIG_DRM_ETNAVIV=m
CONFIG_DRM_TEGRA=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_AMDGPU=m

# --- Input / HID (Arm laptops: I2C-HID over device tree) ---
CONFIG_INPUT_EVDEV=y
CONFIG_HIDRAW=y
CONFIG_UHID=m
CONFIG_HID_MULTITOUCH=m
CONFIG_I2C_HID=m
CONFIG_I2C_HID_OF=m

# --- SoC platforms (desktop-relevant) ---
CONFIG_ARCH_APPLE=y
CONFIG_ARCH_BCM2835=y
CONFIG_ARCH_QCOM=y
CONFIG_ARCH_ROCKCHIP=y
CONFIG_ARCH_SUNXI=y
CONFIG_ARCH_TEGRA=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_ARCH_MESON=y

# --- Power management (ARM uses DT / SCMI cpufreq, not x86 pstate) ---
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_SCMI_PROTOCOL=y
CONFIG_ARM_SCMI_CPUFREQ=m
CONFIG_SUSPEND=y

# --- Universal peripherals (Wi-Fi/BT/NIC drivers are arch-independent and
#     mostly already in arm64 defconfig) ---
CONFIG_SND_USB_AUDIO=m
CONFIG_USB_VIDEO_CLASS=m
