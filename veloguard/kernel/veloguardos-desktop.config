# VeloGuardOS — desktop enablement fragment (Wayland + PipeWire + GNOME)
#
# These are the KERNEL prerequisites the desktop stack needs. The desktop
# itself is userspace — see ../provision/install-desktop.sh. Every symbol here
# is verified to exist in the cloned tree.
#
# Merge into a base config (run from the kernel tree root):
#   ./scripts/kconfig/merge_config.sh -m arch/x86/configs/x86_64_defconfig \
#       veloguard/kernel/veloguardos-desktop.config
#   make olddefconfig
#
# Philosophy ("lightweight like Arch"): GPU drivers are modules so only the
# card you have loads; the always-present bits (DRM core, virtio-gpu, evdev)
# are built in so the box always reaches a graphical session, including in a VM.
#
# NOTE: kconfig .config syntax forbids inline comments after a value, so every
# note lives on its own line.

# --- DRM / KMS: the foundation every Wayland compositor (Mutter) sits on ---
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
# SIMPLEDRM: generic framebuffer — guarantees *some* display on any hardware.
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- GPU drivers (modules; the matching one auto-loads) ---
# I915 = Intel (this dev box: Iris Xe).
CONFIG_DRM_I915=m
# AMDGPU = AMD.
CONFIG_DRM_AMDGPU=m
# NOUVEAU = NVIDIA open driver; proprietary CUDA stack is layered later.
CONFIG_DRM_NOUVEAU=m
# VIRTIO_GPU built in so VMs/cloud guests boot straight to a graphical session.
CONFIG_DRM_VIRTIO_GPU=y

# --- Buffer sharing + explicit sync: zero-copy frame path for Wayland/PipeWire ---
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_SYNC_FILE=y
CONFIG_DMABUF_HEAPS=y
CONFIG_UDMABUF=y

# --- Input: libinput/Wayland reach devices via evdev ---
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=m
CONFIG_HIDRAW=y
CONFIG_UHID=m

# --- Audio: PipeWire rides on ALSA ---
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_USB_AUDIO=m

# --- USB: keyboards, mice, audio interfaces, webcams ---
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y

# --- Security posture (it's GuardOS): sandboxing primitives for desktop apps ---
CONFIG_SECCOMP=y
CONFIG_SECURITY_LANDLOCK=y
