# VeloGuardOS — base/system fragment: what a STANDALONE DESKTOP actually needs
# beyond drivers. This is the glue: boot, systemd's kernel prerequisites,
# sandboxing primitives for universal package formats, the netfilter/nftables
# stack VeloGuard's own guard drives, WireGuard (the built-in VPN), and laptop
# power management.
#
# Merge it FIRST (before desktop + hardware):
#   ./scripts/kconfig/merge_config.sh -m arch/x86/configs/x86_64_defconfig \
#       veloguard/kernel/veloguardos-base.config \
#       veloguard/kernel/veloguardos-desktop.config \
#       veloguard/kernel/veloguardos-hardware.config
#   make olddefconfig

# ===========================================================================
# Boot / firmware / initramfs — UEFI machines + an initramfs to load modules.
# ===========================================================================
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# BINFMT_MISC: lets the system run foreign binaries (Wine, some installers).
CONFIG_BINFMT_MISC=m

# ===========================================================================
# systemd's kernel requirements (a desktop won't boot cleanly without these).
# ===========================================================================
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_CONFIGFS_FS=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y

# ===========================================================================
# Namespaces + cgroups — required by systemd AND by every app sandbox
# (Flatpak/bubblewrap, AppImage, containers). USER_NS is the linchpin.
# ===========================================================================
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ===========================================================================
# Sandbox filesystems — AppImage (FUSE+squashfs), Snap (squashfs),
# Flatpak/containers (overlayfs). FUSE/SQUASHFS/OVERLAY also set in hardware;
# here we add the squashfs decompressors AppImages/snaps actually use.
# ===========================================================================
CONFIG_FUSE_FS=y
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_OVERLAY_FS=m

# ===========================================================================
# Netfilter / nftables — the kernel side of VeloGuard's guard + the firewall.
# Without NF_TABLES the `nft` executor has nothing to talk to.
# ===========================================================================
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_LOG=m
# XTABLES ends up built-in (selected by iptables compat in the base defconfig).
CONFIG_NETFILTER_XTABLES=y

# ===========================================================================
# Android containers (Waydroid) — binder IPC + binderfs. ASHMEM is gone in
# modern kernels; Waydroid uses binderfs + memfd instead.
# ===========================================================================
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# ===========================================================================
# VPN + virtual networking — WireGuard is your "built-in VPN"; TUN powers
# almost every other VPN client; veth/bridge/vlan round out connectivity.
# ===========================================================================
CONFIG_WIREGUARD=m
CONFIG_TUN=m
CONFIG_VETH=m
CONFIG_BRIDGE=m
CONFIG_VLAN_8021Q=m

# ===========================================================================
# Disk encryption crypto (LUSK/LUKS via dm-crypt, already a module in hardware).
# ===========================================================================
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES_NI_INTEL=y

# ===========================================================================
# Power management — suspend/resume, CPU scaling, laptop backlight/battery.
# ===========================================================================
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_ACPI_BATTERY=m
CONFIG_ACPI_AC=m
CONFIG_ACPI_VIDEO=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y
