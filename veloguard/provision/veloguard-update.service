# VeloGuardOS — periodic update CHECK (read-only, signed, never auto-applies).
# Install:
#   install -m644 veloguard-update.{service,timer} /etc/systemd/system/
#   systemctl enable --now veloguard-update.timer
[Unit]
Description=VeloGuardOS signed update check (read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/veloguard-update check
# Quietly pre-download + verify a new SIGNED kernel into staging. This does NOT
# apply it — installing happens on reboot, and only if the user ticks the box on
# the restart dialog. '-' = non-fatal when the channel is dark/offline.
ExecStart=-/usr/local/bin/veloguard-update kernel --stage --apply
