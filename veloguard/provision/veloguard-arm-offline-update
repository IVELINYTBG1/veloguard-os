#!/usr/bin/env bash
#
# veloguard-arm-offline-update — fixed entry point for "arm the staged offline
# kernel update so it installs on the next reboot". Runs as root via pkexec; the
# polkit rule 49-veloguard-offline-update.rules lets the active local user do it
# without a password. The single fixed path is what makes that rule safe.
exec veloguard-update kernel --arm
