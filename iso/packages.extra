# VeloGuardOS — packages appended to archiso 'releng' base (base/linux/syslinux/
# networking/archinstall already come from releng). Keep it lean ("like Arch").

# networking for the desktop
networkmanager
# Bluetooth userspace (kernel btusb is in our hardware fragment / Arch kernel)
bluez
bluez-utils

# desktop: Wayland + PipeWire + GNOME (minimal)
gnome-shell
gdm
nautilus
gnome-console
gnome-control-center
gnome-software
xdg-desktop-portal-gnome
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
mesa

# VeloGuard security stack (kernel-side userspace the guard drives)
nftables
wireguard-tools
bubblewrap
tor

# universal package formats (default apps install via flatpak on first run)
flatpak

# Bulgarian Mode + media
mpv
ffmpeg

# extra filesystem support
exfatprogs
ntfs-3g

# installer must be able to make the ESP + install the bootloader on the target
# (releng usually carries these; explicit so the GUI installer can't regress)
grub
efibootmgr
dosfstools

# guard runtime
python

# Wi-Fi backend (the real fix: NM needs wpa_supplicant or all nets show "open")
wpa_supplicant

# Wi-Fi on ANY hardware: every wifi-relevant firmware family explicitly (the
# linux-firmware meta's coverage is not contractual), the regulatory db, and
# mode-switching for USB dongles that enumerate as fake CD-ROMs. The one gap —
# Broadcom chips needing proprietary 'wl' — ships as an OFFLINE package in
# /opt/veloguard/drivers, installed on demand by veloguard-wifi-autodetect
# (never preinstalled: wl's modprobe blacklists would break b43/brcmfmac users).
linux-firmware-atheros
linux-firmware-broadcom
linux-firmware-intel
linux-firmware-marvell
linux-firmware-mediatek
linux-firmware-qcom
linux-firmware-realtek
linux-firmware-other
wireless-regdb
usb_modeswitch

# GUI dialogs: the restart-update prompt + the VPN "Import config…" flow
zenity

# every distro should have git; base-devel + git = AUR works manually, and
# build.sh also bakes in the 'yay' AUR helper from a local repo.
git
base-devel
go

# NOTE: Calamares (GUI installer) is staged in iso/airootfs/etc/calamares but not
# installed yet — it isn't in Arch's repos and the Chaotic-AUR pull was flaky.
# The live ISO uses archinstall for now; Calamares needs an AUR makepkg build.

