// Let the active local user arm a VeloGuardOS offline kernel update without a
// password — the same trust model Fedora/PackageKit uses for offline updates.
// Only pkexec of our one fixed wrapper is granted; nothing else. Matched by
// BOTH its PATH symlink and its real /opt path, because pkexec canonicalizes
// the program path before polkit sees it.
polkit.addRule(function (action, subject) {
    if (action.id === "org.freedesktop.policykit.exec") {
        var p = action.lookup("program");
        if ((p === "/usr/local/bin/veloguard-arm-offline-update" ||
             p === "/opt/veloguard/provision/veloguard-arm-offline-update") &&
            subject.active && subject.local) {
            return polkit.Result.YES;
        }
    }
});
